# icloud-api 环境变量示例。复制为 .env 后填入真实值。
# 管理员密码(必填,至少 8 个字符)。服务启动后会从进程环境中删除。
ICLOUD_API_ADMIN_PASSWORD=change-me-to-a-strong-password
# 会话有效期(Go 风格时长,如 12h / 90m / 15m)。默认 12h。
# 注意:超出 15m–168h 范围的值会静默回落到 12h(与 Go 的 parseSessionTTL bug 保持一致)。
ICLOUD_API_SESSION_TTL=12h
# 会话 Cookie 是否标记 Secure(仅 HTTPS 部署时开启)。
ICLOUD_API_SECURE_COOKIE=false
# 监听地址与端口。
HOST=0.0.0.0
PORT=8081
# SQLite 数据库目录(data/icloud.db)。
DATA_DIR=./data
# 日志级别: debug | info | warn | error。
LOG_LEVEL=info
